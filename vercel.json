{
  "version": 2,
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/login",
      "methods": ["POST"],
      "dest": "api/index.js"
    },
    {
      "src": "/register",
      "dest": "api/index.js"
    },
    {
      "src": "/students(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/upload(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/test",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
